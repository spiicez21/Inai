# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
dist/
build/

# Secrets — Razorpay test keys, Anthropic key (DATA.md §9)
.env
.env.*
!.env.example

# Run artifacts (regenerable from seed + config)
runs/
