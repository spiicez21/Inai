# LLM replay cache IS committed — determinism depends on it.
!data/llm_cache/

# Node / UI
node_modules/
ui/dist/
ui/.vite/
*.tsbuildinfo

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
